{
  "info": {
    "name": "Alimentador WBM",
    "description": "API REST do backend (Spring Boot). Rode 'Login' primeiro — o token é salvo automaticamente nas variáveis da collection e usado por todas as outras requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",  "value": "http://localhost:8080" },
    { "key": "token",     "value": "" },
    { "key": "device_id", "value": "ALIMENTADOR_3" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('token', body.token);",
                  "  console.log('Token salvo:', body.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@wbm.com\",\n  \"password\": \"\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [ "{{base_url}}" ],
              "path": [ "api", "auth", "login" ]
            }
          }
        },
        {
          "name": "Validar token",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": {
              "raw": "{{base_url}}/api/auth/validate",
              "host": [ "{{base_url}}" ],
              "path": [ "api", "auth", "validate" ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": {
              "raw": "{{base_url}}/api/auth/logout",
              "host": [ "{{base_url}}" ],
              "path": [ "api", "auth", "logout" ]
            }
          }
        }
      ]
    },
    {
      "name": "Conta",
      "item": [
        {
          "name": "Meus devices e perfis",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": {
              "raw": "{{base_url}}/api/me/devices",
              "host": [ "{{base_url}}" ],
              "path": [ "api", "me", "devices" ]
            }
          }
        },
        {
          "name": "Labels de todos os devices",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": {
              "raw": "{{base_url}}/api/labels",
              "host": [ "{{base_url}}" ],
              "path": [ "api", "labels" ]
            }
          }
        },
        {
          "name": "Salvar label de um device",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Alimentador 3\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/labels/{{device_id}}",
              "host": [ "{{base_url}}" ],
              "path": [ "api", "labels", "{{device_id}}" ]
            }
          }
        }
      ]
    },
    {
      "name": "Device",
      "item": [
        {
          "name": "Última telemetria",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": {
              "raw": "{{base_url}}/api/devices/{{device_id}}/telemetry/latest",
              "host": [ "{{base_url}}" ],
              "path": [ "api", "devices", "{{device_id}}", "telemetry", "latest" ]
            }
          }
        },
        {
          "name": "Histórico de telemetria",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": {
              "raw": "{{base_url}}/api/devices/{{device_id}}/telemetry?limit=200",
              "host": [ "{{base_url}}" ],
              "path": [ "api", "devices", "{{device_id}}", "telemetry" ],
              "query": [ { "key": "limit", "value": "200" } ]
            }
          }
        },
        {
          "name": "Última vez visto (last-seen)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": {
              "raw": "{{base_url}}/api/devices/{{device_id}}/last-seen",
              "host": [ "{{base_url}}" ],
              "path": [ "api", "devices", "{{device_id}}", "last-seen" ]
            }
          }
        },
        {
          "name": "Estatísticas (stats)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": {
              "raw": "{{base_url}}/api/devices/{{device_id}}/stats",
              "host": [ "{{base_url}}" ],
              "path": [ "api", "devices", "{{device_id}}", "stats" ]
            }
          }
        },
        {
          "name": "Erros",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": {
              "raw": "{{base_url}}/api/devices/{{device_id}}/errors?limit=50",
              "host": [ "{{base_url}}" ],
              "path": [ "api", "devices", "{{device_id}}", "errors" ],
              "query": [ { "key": "limit", "value": "50" } ]
            }
          }
        }
      ]
    },
    {
      "name": "Histórico de tratos",
      "item": [
        {
          "name": "Listar histórico",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": {
              "raw": "{{base_url}}/api/devices/{{device_id}}/history?limit=100",
              "host": [ "{{base_url}}" ],
              "path": [ "api", "devices", "{{device_id}}", "history" ],
              "query": [ { "key": "limit", "value": "100" } ]
            }
          }
        },
        {
          "name": "Registrar trato manual",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grams\": 50,\n  \"source\": \"manual\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/devices/{{device_id}}/history",
              "host": [ "{{base_url}}" ],
              "path": [ "api", "devices", "{{device_id}}", "history" ]
            }
          }
        },
        {
          "name": "Apagar uma entrada do histórico",
          "request": {
            "method": "DELETE",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": {
              "raw": "{{base_url}}/api/devices/{{device_id}}/history/1",
              "host": [ "{{base_url}}" ],
              "path": [ "api", "devices", "{{device_id}}", "history", "1" ]
            }
          }
        },
        {
          "name": "Limpar todo o histórico",
          "request": {
            "method": "DELETE",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": {
              "raw": "{{base_url}}/api/devices/{{device_id}}/history",
              "host": [ "{{base_url}}" ],
              "path": [ "api", "devices", "{{device_id}}", "history" ]
            }
          }
        }
      ]
    }
  ]
}
